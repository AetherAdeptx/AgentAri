<?xml version="1.0" encoding="UTF-8"?>
<CodeBlocks_project_file>
  <FileVersion major="1" minor="6"/>
  <Project>
    <Option title="AgentAri"/>
    <Option makefile_is_custom="1"/>
    <Option compiler="gcc"/>
    <Option virtualFolders="CMake Files\;Headers\;Sources\;Tests\;Tools\;Shaders\;"/>
    <Build>
      <Target title="Core and tests">
        <Option working_dir="$(PROJECT_DIR)"/>
        <Option type="4"/>
        <MakeCommands>
          <Build command="cmake -S &quot;$(PROJECT_DIR)&quot; -B &quot;$(PROJECT_DIR)/build-codeblocks&quot; -G &quot;Unix Makefiles&quot; -DAGENTARI_BUILD_APP=OFF -DAGENTARI_ENABLE_VULKAN=OFF -DCMAKE_BUILD_TYPE=Debug &amp;&amp; cmake --build &quot;$(PROJECT_DIR)/build-codeblocks&quot; --parallel"/>
          <Clean command="cmake --build &quot;$(PROJECT_DIR)/build-codeblocks&quot; --target clean"/>
          <DistClean command="cmake -S &quot;$(PROJECT_DIR)&quot; -B &quot;$(PROJECT_DIR)/build-codeblocks&quot; -G &quot;Unix Makefiles&quot; -DAGENTARI_BUILD_APP=OFF -DAGENTARI_ENABLE_VULKAN=OFF -DCMAKE_BUILD_TYPE=Debug &amp;&amp; cmake --build &quot;$(PROJECT_DIR)/build-codeblocks&quot; --target clean"/>
        </MakeCommands>
      </Target>
      <Target title="Console">
        <Option output="build-codeblocks/agentari-console" prefix_auto="0" extension_auto="0"/>
        <Option working_dir="$(PROJECT_DIR)"/>
        <Option type="1"/>
        <MakeCommands>
          <Build command="cmake -S &quot;$(PROJECT_DIR)&quot; -B &quot;$(PROJECT_DIR)/build-codeblocks&quot; -G &quot;Unix Makefiles&quot; -DAGENTARI_BUILD_APP=OFF -DAGENTARI_ENABLE_VULKAN=OFF -DCMAKE_BUILD_TYPE=Debug &amp;&amp; cmake --build &quot;$(PROJECT_DIR)/build-codeblocks&quot; --target agentari-console --parallel"/>
          <Clean command="cmake --build &quot;$(PROJECT_DIR)/build-codeblocks&quot; --target clean"/>
        </MakeCommands>
      </Target>
      <Target title="Run tests">
        <Option working_dir="$(PROJECT_DIR)"/>
        <Option type="4"/>
        <MakeCommands>
          <Build command="cmake -S &quot;$(PROJECT_DIR)&quot; -B &quot;$(PROJECT_DIR)/build-codeblocks&quot; -G &quot;Unix Makefiles&quot; -DAGENTARI_BUILD_APP=OFF -DAGENTARI_ENABLE_VULKAN=OFF -DCMAKE_BUILD_TYPE=Debug &amp;&amp; cmake --build &quot;$(PROJECT_DIR)/build-codeblocks&quot; --parallel &amp;&amp; ctest --test-dir &quot;$(PROJECT_DIR)/build-codeblocks&quot; --output-on-failure"/>
          <Clean command="cmake --build &quot;$(PROJECT_DIR)/build-codeblocks&quot; --target clean"/>
        </MakeCommands>
      </Target>
      <Target title="SDL application">
        <Option output="build-codeblocks/agent-ari" prefix_auto="0" extension_auto="0"/>
        <Option working_dir="$(PROJECT_DIR)"/>
        <Option type="1"/>
        <MakeCommands>
          <Build command="cmake -S &quot;$(PROJECT_DIR)&quot; -B &quot;$(PROJECT_DIR)/build-codeblocks&quot; -G &quot;Unix Makefiles&quot; -DAGENTARI_BUILD_APP=ON -DAGENTARI_ENABLE_VULKAN=ON -DCMAKE_BUILD_TYPE=Debug &amp;&amp; cmake --build &quot;$(PROJECT_DIR)/build-codeblocks&quot; --target agent-ari --parallel"/>
          <Clean command="cmake --build &quot;$(PROJECT_DIR)/build-codeblocks&quot; --target clean"/>
        </MakeCommands>
      </Target>
    </Build>
